#!/usr/bin/env python3
"""Open Linux files with sensible, user-friendly applications."""

from __future__ import annotations

import argparse
import mimetypes
import os
import shlex
import shutil
import subprocess
import sys
from pathlib import Path
from urllib.parse import urlparse

VERSION = "1.3.0"

TEX_EXTENSIONS = {".tex", ".ltx"}
DOCUMENT_EXTENSIONS = {".pdf", ".eps", ".ps"}
IMAGE_EXTENSIONS = {
    ".png", ".jpg", ".jpeg", ".jpe", ".gif", ".bmp", ".webp",
    ".tif", ".tiff", ".svg", ".heic", ".avif", ".ico",
}
TEXT_EXTENSIONS = {
    ".txt", ".text", ".md", ".rst", ".log", ".csv", ".tsv",
    ".py", ".pyw", ".c", ".h", ".cc", ".cpp", ".cxx", ".hpp",
    ".java", ".js", ".jsx", ".ts", ".tsx", ".go", ".rs", ".rb",
    ".php", ".pl", ".pm", ".r", ".sh", ".bash", ".zsh", ".fish",
    ".html", ".htm", ".css", ".scss", ".xml", ".json", ".jsonl",
    ".yaml", ".yml", ".toml", ".ini", ".cfg", ".conf", ".sql",
    ".f", ".f90", ".f95", ".m", ".swift", ".kt", ".lua",
    ".gitignore", ".dockerfile", ".makefile",
}
TEXT_BASENAMES = {
    "makefile", "dockerfile", "readme", "license", "copying", "authors",
    "changelog", "cmakelists.txt", ".bashrc", ".zshrc", ".profile",
}


def find_command(preferred: str, fallbacks: tuple[str, ...] = ()) -> str:
    """Resolve an environment override, preferred app, or fallback command."""
    for candidate in (preferred, *fallbacks):
        resolved = shutil.which(candidate)
        if resolved:
            return resolved
    raise RuntimeError(f"No suitable application found (tried: {', '.join((preferred, *fallbacks))}).")


def is_url(value: str) -> bool:
    parsed = urlparse(value)
    return parsed.scheme in {"http", "https", "ftp", "mailto"}


def is_probably_text(path: Path) -> bool:
    """Recognize extensionless and unfamiliar ASCII/Unicode text files."""
    mime, _ = mimetypes.guess_type(str(path))
    if mime and (mime.startswith("text/") or mime in {"application/json", "application/xml"}):
        return True
    if not path.is_file():
        return False
    try:
        sample = path.read_bytes()[:8192]
    except OSError:
        return False
    if b"\0" in sample:
        return False
    try:
        sample.decode("utf-8")
        return True
    except UnicodeDecodeError:
        printable = sum(byte in b"\n\r\t\b\f" or 32 <= byte < 127 for byte in sample)
        return bool(sample) and printable / len(sample) > 0.85


def select_application(target: str) -> tuple[str, str]:
    """Return application command and routing category for a target."""
    desktop_opener = os.environ.get("LINUX_OPEN_VIEWER", "xdg-open")
    if is_url(target):
        return find_command(desktop_opener, ("gio",)), "desktop"

    path = Path(target).expanduser()
    if path.is_dir():
        return find_command(desktop_opener, ("gio",)), "desktop"

    suffix = path.suffix.lower()
    basename = path.name.lower()
    if suffix in TEX_EXTENSIONS:
        return find_command(os.environ.get("LINUX_OPEN_TEX_EDITOR", "texstudio"), ("kate", desktop_opener)), "tex"
    if suffix in IMAGE_EXTENSIONS:
        return find_command(os.environ.get("LINUX_OPEN_IMAGE_VIEWER", "eog"), (desktop_opener, "gio")), "image"
    if suffix in DOCUMENT_EXTENSIONS:
        return find_command(os.environ.get("LINUX_OPEN_DOCUMENT_VIEWER", "evince"), (desktop_opener, "gio")), "document"
    if suffix in TEXT_EXTENSIONS or basename in TEXT_BASENAMES or is_probably_text(path):
        return find_command(os.environ.get("LINUX_OPEN_TEXT_EDITOR", "kate"), ("gedit", "gnome-text-editor", desktop_opener)), "text"
    return find_command(desktop_opener, ("gio",)), "desktop"


def command_for(target: str) -> tuple[list[str], str]:
    app, category = select_application(target)
    argument = target if is_url(target) else str(Path(target).expanduser().resolve())
    if Path(app).name == "gio":
        return [app, "open", argument], category
    return [app, argument], category


def build_launch_groups(targets: list[str]) -> list[tuple[list[str], str, list[str]]]:
    """Group compatible targets so one application opens tabs/gallery items."""
    grouped: dict[tuple[str, str], list[str]] = {}
    order: list[tuple[str, str]] = []
    for target in targets:
        app, category = select_application(target)
        argument = target if is_url(target) else str(Path(target).expanduser().resolve())
        key = (app, category)
        # xdg-open/gio accept only one target per process.
        if Path(app).name in {"xdg-open", "gio"}:
            key = (app, f"{category}:{len(order)}")
        if key not in grouped:
            grouped[key] = []
            order.append(key)
        grouped[key].append(argument)

    launches: list[tuple[list[str], str, list[str]]] = []
    for app, keyed_category in order:
        category = keyed_category.split(":", 1)[0]
        arguments = grouped[(app, keyed_category)]
        if Path(app).name == "gio":
            command = [app, "open", *arguments]
        elif category == "image" and Path(app).name == "eog":
            command = [app, "--single-window", *arguments]
        else:
            command = [app, *arguments]
        launches.append((command, category, arguments))
    return launches


def ensure_local_target(target: str, create: bool = True) -> tuple[bool, bool]:
    """Create a missing local file; return (usable, newly_created)."""
    if is_url(target):
        return True, False
    path = Path(target).expanduser()
    if path.exists():
        return True, False
    if not path.parent.exists():
        print(f"open: parent directory does not exist: {path.parent}", file=sys.stderr)
        return False, False
    if not path.parent.is_dir():
        print(f"open: parent path is not a directory: {path.parent}", file=sys.stderr)
        return False, False
    if not create:
        return True, True
    try:
        path.touch(exist_ok=False)
    except OSError as exc:
        print(f"open: could not create {path}: {exc}", file=sys.stderr)
        return False, False
    return True, True


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="open",
        description="Open TeX in TeXstudio, code/text in Kate, and documents/images in the desktop viewer.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Dependencies by file type:
  All targets               python3 (3.10+)
  Directories and URLs      xdg-open, package: xdg-utils
  .tex, .ltx                texstudio, package: texstudio
  LaTeX compilation         pdflatex/latexmk, packages: texlive-latex-extra latexmk
  Code, text, ASCII files   kate, package: kate
  .pdf, .eps, .ps           desktop viewer; recommended package: evince
  PNG, JPEG, other images   desktop viewer; recommended package: eog

Ubuntu/Debian installation:
  sudo apt install python3 xdg-utils kate texstudio evince eog
  sudo apt install texlive-latex-extra texlive-fonts-recommended latexmk biber

Fallback behavior:
  If TeXstudio or Kate is unavailable, linux-open tries another editor and
  finally xdg-open. Viewer formats always use the desktop's default application.

Use `open --dry-run FILE` to inspect routing without opening or creating FILE.
See the repository README for Fedora, Arch/Manjaro, and openSUSE commands.
""",
    )
    parser.add_argument("targets", nargs="+", help="Files, directories, or URLs to open.")
    parser.add_argument("--dry-run", action="store_true", help="Print routing without opening applications.")
    parser.add_argument("--wait", action="store_true", help="Wait until each launched application exits.")
    parser.add_argument("--version", action="version", version=f"linux-open {VERSION}")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    exit_code = 0
    usable_targets: list[str] = []
    for target in args.targets:
        usable, created = ensure_local_target(target, create=not args.dry_run)
        if not usable:
            exit_code = 1
            continue
        usable_targets.append(target)
        if args.dry_run:
            try:
                command, category = command_for(target)
            except RuntimeError as exc:
                print(f"open: {exc}", file=sys.stderr)
                exit_code = 1
                continue
            created_label = " [would create]" if created else ""
            print(f"{category:8} {target}{created_label} -> {shlex.join(command)}")

    if args.dry_run:
        return exit_code

    try:
        launches = build_launch_groups(usable_targets)
    except RuntimeError as exc:
        print(f"open: {exc}", file=sys.stderr)
        return 1

    for command, _category, _arguments in launches:
        try:
            if args.wait:
                result = subprocess.run(command, check=False)
                exit_code = result.returncode or exit_code
            else:
                subprocess.Popen(
                    command,
                    start_new_session=True,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
        except OSError as exc:
            print(f"open: could not launch {command[0]}: {exc}", file=sys.stderr)
            exit_code = 1
    return exit_code


if __name__ == "__main__":
    raise SystemExit(main())
